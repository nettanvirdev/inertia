{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Inertia",
  "mainBinaryName": "inertia",
  "version": "0.1.0",
  "identifier": "com.nettanvirdev.inertia",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Inertia",
        "width": 1320,
        "height": 860,
        "minWidth": 940,
        "minHeight": 620,
        "center": true,
        "decorations": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; frame-src http://127.0.0.1:* https://*.daytonaproxy01.net https://*.daytona.work; object-src 'none'; base-uri 'self'; form-action 'none'",
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "compression": "lzma",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "publisher": "Tanvir Ahamed",
    "copyright": "Copyright (c) 2026 Tanvir Ahamed. MIT License.",
    "license": "MIT",
    "homepage": "https://nettanvir.dev/inertia-ai",
    "category": "DeveloperTool",
    "shortDescription": "A desktop workspace for AI agents",
    "longDescription": "Inertia is a desktop workspace for AI agents: chat, built-in tools, MCP and OpenAPI integrations, sandboxed computers, routines and memory.",
    "resources": {
      "../LICENSE": "LICENSE.txt",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    }
  }
}
