{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Inertia Setup",
  "version": "0.1.0",
  "identifier": "com.nettanvirdev.inertia.setup",
  "build": {
    "beforeDevCommand": "bun run dev:setup-ui",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "bun run build:setup-ui",
    "frontendDist": "../../dist-installer"
  },
  "app": {
    "windows": [
      {
        "label": "setup",
        "title": "Inertia Setup",
        "width": 460,
        "height": 560,
        "resizable": false,
        "maximizable": false,
        "center": true,
        "decorations": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["../../src-tauri/icons/icon.ico", "../../src-tauri/icons/128x128.png"]
  }
}
