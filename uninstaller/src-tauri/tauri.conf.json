{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Inertia Uninstall",
  "version": "0.1.0",
  "identifier": "com.nettanvirdev.inertia.uninstall",
  "build": {
    "beforeDevCommand": "bun run dev:setup-ui",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "bun run build:setup-ui",
    "frontendDist": "../../dist-installer"
  },
  "app": {
    "windows": [
      {
        "label": "setup",
        "title": "Uninstall Inertia",
        "width": 460,
        "height": 520,
        "resizable": false,
        "maximizable": false,
        "center": true,
        "decorations": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'none'",
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "../../src-tauri/icons/icon.ico",
      "../../src-tauri/icons/128x128.png"
    ]
  }
}
