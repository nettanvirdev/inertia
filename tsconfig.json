{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* The app's `src/` is plain JSX with no types, on purpose. `allowJs` lets
       the installer's TypeScript import from it; `checkJs` stays off because
       that JavaScript - which began as a port of an earlier Electron app - was
       never written to satisfy a type checker, and checking it would report
       noise rather than bugs. */
    "allowJs": true,
    "checkJs": false,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Path aliases */
    "paths": {
      "@/*": ["./src/*"],
      "@shared/*": ["./src/shared/*"],
      "@setup/*": ["./installer/src/*"]
    },

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "installer/src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
