{
  "name": "inertia",
  "private": true,
  "version": "0.1.0",
  "description": "A desktop workspace for AI agents: chat, tools, sandboxes, routines and memory.",
  "license": "MIT",
  "author": "Tanvir Ahamed",
  "homepage": "https://nettanvir.dev/inertia-ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/nettanvirdev/inertia.git"
  },
  "bugs": "https://github.com/nettanvirdev/inertia/issues",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest run",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\" \"installer/src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css}\" \"installer/src/**/*.{ts,tsx,css}\"",
    "notices": "node scripts/third-party-notices.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "dev:setup-ui": "vite --config vite.installer.config.ts",
    "build:setup-ui": "tsc && vite build --config vite.installer.config.ts",
    "dev:setup": "cd installer/src-tauri && bunx tauri dev",
    "build:setup": "node scripts/build-setup.mjs",
    "dev:uninstall": "cd uninstaller/src-tauri && bunx tauri dev"
  },
  "dependencies": {
    "@fontsource-variable/anek-bangla": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/noto-sans-bengali": "^5.3.0",
    "@fontsource-variable/noto-serif-bengali": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@radix-ui/react-slot": "^1.3.3",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-opener": "^2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "9",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "9",
    "eslint-plugin-react": "7",
    "eslint-plugin-react-hooks": "5",
    "globals": "^17.13.0",
    "prettier": "3",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.10"
  }
}
